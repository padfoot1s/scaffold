# ---------------------------------------------------------------------------
# inswa agent layer configuration. ALL environment variables live here and are
# read ONLY by src/inswa/config/settings.py. Copy to `.env` and fill in.
# Nested sections use "__" (e.g. COSMOS__PROVIDER).
# ---------------------------------------------------------------------------

# --- Azure auth: cli | default | managed_identity ---------------------------
# Local development: cli (az login). Deployed containers: managed_identity.
AZURE__CREDENTIAL=cli
AZURE__MANAGED_IDENTITY_CLIENT_ID=

# --- Microsoft Foundry (no local stand-in; a real project is required) ------
# In a Foundry hosted container FOUNDRY_PROJECT_ENDPOINT / AZURE_AI_MODEL_DEPLOYMENT_NAME
# are injected by the platform and used as fallbacks for the two values below.
FOUNDRY__PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# Reasoning model for every agent role, and the API family it uses:
#   openai    -> Foundry Responses API (GPT models)
#   anthropic -> Claude deployed in the same Foundry resource (Anthropic Messages API)
FOUNDRY__DEFAULT_MODEL=gpt-5.4-mini
FOUNDRY__DEFAULT_PROVIDER=openai
# Light model for the orchestrator's intent-routing step.
FOUNDRY__MODELS__ROUTER=gpt-5.4-mini
FOUNDRY__PROVIDERS__ROUTER=openai
# Optional per-role overrides (empty = the defaults above), e.g. FOUNDRY__MODELS__RCA=<deployment>
# and FOUNDRY__PROVIDERS__RCA=anthropic. Roles: orchestrator, forecasting, variance_analysis,
# statistical_explainability, rca, market_trend, market_recommendations.
# Claude only: endpoint (empty = https://<account>.services.ai.azure.com/anthropic/ from the
# project endpoint) and max output tokens (Anthropic requires one; the client default is 1024).
FOUNDRY__ANTHROPIC_BASE_URL=
FOUNDRY__ANTHROPIC_MAX_TOKENS=4096

# --- Agents: feature flags + transport (inprocess | hosted) ------------------
AGENTS__DEFINITIONS_DIR=agents
AGENTS__FORECASTING__ENABLED=true
AGENTS__FORECASTING__TRANSPORT=inprocess
AGENTS__FORECASTING__HOSTED_NAME=inswa-forecasting
AGENTS__VARIANCE_ANALYSIS__ENABLED=true
AGENTS__VARIANCE_ANALYSIS__TRANSPORT=inprocess
AGENTS__VARIANCE_ANALYSIS__HOSTED_NAME=inswa-variance-analysis
AGENTS__STATISTICAL_EXPLAINABILITY__ENABLED=true
AGENTS__STATISTICAL_EXPLAINABILITY__TRANSPORT=inprocess
AGENTS__STATISTICAL_EXPLAINABILITY__HOSTED_NAME=inswa-statistical-explainability
AGENTS__RCA__ENABLED=true
AGENTS__RCA__TRANSPORT=inprocess
AGENTS__RCA__HOSTED_NAME=inswa-rca
AGENTS__MARKET_RECOMMENDATIONS__ENABLED=true
AGENTS__MARKET_RECOMMENDATIONS__TRANSPORT=inprocess
AGENTS__MARKET_RECOMMENDATIONS__HOSTED_NAME=inswa-market-recommendations
# Switched off by flag
AGENTS__MARKET_TREND__ENABLED=false
AGENTS__MARKET_TREND__HOSTED_NAME=inswa-market-trend

# --- Orchestration ------------------------------------------------------------
# Forecast grain the orchestrator asks for before calling any tool (JSON list).
ORCHESTRATION__REQUIRED_SLOTS=["sku", "primary_customer", "week"]
ORCHESTRATION__SPECIALIST_TIMEOUT_SECONDS=90
ORCHESTRATION__MAX_EVIDENCE_CHARS=8000
# Reject answers whose figures are not in the tool data or documents.
ORCHESTRATION__GROUNDING_CHECK=true
ORCHESTRATION__MAX_FEEDBACK_ITEMS=3

# --- MCP tools server (local mock by default) --------------------------------
MCP__URL=http://localhost:8765/mcp
# none (local mock) | entra (managed-identity bearer token for MCP__SCOPE)
MCP__AUTH=none
MCP__SCOPE=
MCP__REQUEST_TIMEOUT=30
MCP__MOCK_HOST=127.0.0.1
MCP__MOCK_PORT=8765

# --- Cosmos DB (memory + feedback): local | cosmos ---------------------------
# Entra ID auth only. Containers: memory (partition key /id), feedback (/conversation_id).
COSMOS__PROVIDER=local
COSMOS__ENDPOINT=
COSMOS__DATABASE=inswa
COSMOS__MEMORY_CONTAINER=memory
COSMOS__FEEDBACK_CONTAINER=feedback
COSMOS__LOCAL_PATH=.local/cosmos

# --- Azure AI Search (grounding): local | azure -------------------------------
SEARCH__PROVIDER=local
SEARCH__ENDPOINT=
SEARCH__INDEX=inswa-grounding
# Optional secret name for key auth (empty = Entra ID auth)
SEARCH__API_KEY_SECRET=
SEARCH__LOCAL_CORPUS=data/search_corpus.json
SEARCH__TOP_K=3

# --- Key Vault: local | keyvault ----------------------------------------------
# local resolves secret names from SECRETS__<NAME> entries below.
KEYVAULT__PROVIDER=local
KEYVAULT__URL=
# SECRETS__SEARCH_API_KEY=

# --- Telemetry: console | otlp | appinsights | none ---------------------------
TELEMETRY__EXPORTER=console
TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
# Injected as APPLICATIONINSIGHTS_CONNECTION_STRING in Foundry hosted containers
TELEMETRY__APPINSIGHTS_CONNECTION_STRING=
TELEMETRY__SERVICE_NAME=inswa-agents
TELEMETRY__SENSITIVE_DATA=false

# --- Hosting (Foundry hosted agent server) -----------------------------------
# Which agent this process serves: orchestrator | forecasting | variance_analysis |
# statistical_explainability | rca | market_trend | market_recommendations
HOSTING__AGENT=orchestrator
HOSTING__HOST=0.0.0.0
HOSTING__PORT=8088
# true in deployed containers: refuse to start on local stand-ins or developer credentials
HOSTING__STRICT=false
