# --- Secrets / local configuration ---------------------------------------
# All env vars live in .env; only the template is committed.
.env
.env.*
!.env.example
*.pem
*.key

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# --- Virtual environments -----------------------------------------------
.venv/
venv/
env/

# --- Tooling caches -----------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Local service stand-ins (Cosmos JSON store, etc.) -------------------
.local/

# --- Azure Developer CLI environments (contain subscription details) -----
.azure/

# --- Editors / OS --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
